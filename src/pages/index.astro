        <div class="flex justify-center mb-[30px]">
          <div class="inline-flex items-center gap-2 h-10 bg-[#E3EFFB] text-[#1876CF] text-sm font-medium px-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
            Условия подключения
          </div>
        </div>
        <h2 class="text-3xl md:text-[40px] font-bold text-[#002649] leading-[1.275] text-center mb-[30px]">Тарифы</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {pricingTiers.map((tier) => (
            <div class="bg-white rounded-2xl shadow-[0_8px_30px_0_rgba(125,136,147,0.2)] overflow-hidden">
              <div class="bg-[#1876CF] px-6 md:px-[40px] pt-[30px] pb-5">
                <h3 class="text-2xl font-bold text-white mb-2.5">{tier.name}</h3>
                <div class="flex items-center gap-2.5 text-base text-[#E3EFFB]">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M4.8 21.6v-1.2a4.8 4.8 0 0 1 4.8-4.8h4.8a4.8 4.8 0 0 1 4.8 4.8v1.2"/><circle cx="12" cy="6" r="4.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {tier.users} пользователей
                </div>
              </div>
              <div class="px-6 md:px-[40px] pt-[40px] pb-[40px]">
                <div class="text-[#002649]">
                  <span class="text-3xl md:text-[40px] font-bold">{tier.price} Դ</span>
                  <span class="text-lg font-bold">/ месяц</span>
                </div>
                <div class="text-sm text-[#81909D] mt-1">за всех пользователей</div>
                <div class="border-t border-gray-200 mt-[30px] mb-[30px]"></div>
                {tier.extras.length > 0 ? (
                  <ul class="space-y-2">
                    {tier.extras.map((extra) => (
                      <li class="flex items-center gap-4 text-base text-[#002649]">
                        <span class="w-6 h-6 rounded-md bg-[#1876CF] text-white text-lg font-bold leading-none flex items-center justify-center shrink-0">+</span>
                        {extra}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-base text-[#002649] leading-[1.275]">
                    Каждый тариф включает весь необходимый функционал для электронного ведения пациентов и сотрудников клиники (модули: визиты, картотека, касса, персонал, услуги, статистика, настройки).
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
        <ul class="text-left text-[#81909D] text-sm leading-[1.275] mt-[30px] space-y-1">
          <li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full bg-[#81909D]"></span>Цены в армянских драмах, за всех пользователей клиники в месяц</li>
          <li class="flex items-center gap-3"><span class="w-1 h-1 rounded-full bg-[#81909D]"></span>Крупным клиникам от 50 пользователей будут предложены персональные условия использования сервиса.</li>
        </ul>
      </div>
    </section>

    <!-- БЛОК 6. ЧАСТЫЕ ВОПРОСЫ (FAQ) -->
    <section class="pb-16 md:pb-[120px] px-6 bg-white">
      <div class="max-w-[1140px] mx-auto">
        <div class="flex justify-center mb-[30px]">
          <div class="inline-flex items-center gap-2 h-10 bg-[#E3EFFB] text-[#1876CF] text-sm font-medium px-4 rounded-xl">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
            FAQ
          </div>
        </div>
        <h2 class="text-3xl md:text-[40px] font-bold text-[#002649] leading-[1.275] text-center mb-[30px]">Часто задаваемые вопросы</h2>
        <div class="space-y-4">
          {faqs.map((faq, i) => (
            <div class="bg-white rounded-2xl shadow-[0_8px_30px_0_rgba(125,136,147,0.2)] px-6 py-6 md:px-[50px] md:py-[30px]" data-faq-item>
              <button type="button" data-faq-toggle class="w-full flex items-center justify-between gap-4 text-left">
                <h3 class="text-xl font-bold text-[#002649]">{faq.q}</h3>
                <span data-faq-icon class={`shrink-0 bg-[#E3EFFB] text-[#002649] flex items-center justify-center transition-all ${i === 0 ? 'w-10 h-10 rounded-lg' : 'w-3 h-3 rounded-full'}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class={`w-5 h-5 transition-transform ${i === 0 ? 'rotate-45' : 'hidden'}`}><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
                </span>
              </button>
              <p data-faq-answer class={`text-[#002649] text-base leading-[1.275] mt-2 ${i === 0 ? '' : 'hidden'}`}>{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- БЛОК 7. ФИНАЛЬНЫЙ CTA + ФОРМА ЗАЯВКИ -->
    <section id="form" class="pb-10 md:pb-[60px] px-6 bg-white">
      <div class="max-w-[1140px] mx-auto bg-[#1876CF] rounded-2xl relative overflow-hidden px-6 py-8 md:px-[50px] md:py-[50px]">
        <img src={`${base}cta-paw.png`} alt="" class="absolute hidden lg:block pointer-events-none" style="left:394px;top:115px;width:339px;height:301px;" aria-hidden="true" />
        <div class="grid grid-cols-1 md:grid-cols-[1fr_508px] gap-8 md:gap-12 items-center relative">
          <div class="text-center md:text-left">
            <h2 class="text-3xl md:text-[40px] font-bold text-white leading-[1.275] mb-[30px] max-w-[411px] mx-auto md:mx-0">
              Посмотрите TomaDesk вживую
            </h2>
            <p class="text-white/80 text-sm flex items-center justify-center md:justify-start flex-wrap gap-x-3 gap-y-2">
              <span>Бесплатно</span><span class="w-1.5 h-1.5 rounded-full bg-white/50 shrink-0"></span>
              <span>Онлайн</span><span class="w-1.5 h-1.5 rounded-full bg-white/50 shrink-0"></span>
              <span>Без обязательств</span><span class="w-1.5 h-1.5 rounded-full bg-white/50 shrink-0"></span>
              <span>30 минут</span>
            </p>
          </div>
          <form id="lead-form" class="bg-[#E3EFFB]/95 rounded-2xl p-6 md:p-10 text-left space-y-4">
          <input
            type="text"
            name="name"
            aria-label="Ваше имя"
            placeholder="Ваше имя"
            required
            class="w-full bg-white border-0 rounded-2xl px-4 py-5 text-base focus:outline-none focus:ring-2 focus:ring-[#1876CF]"
          />
          <input
            type="tel"
            name="phone"
            aria-label="Телефон"
            placeholder="Телефон"
            required
            class="w-full bg-white border-0 rounded-2xl px-4 py-5 text-base focus:outline-none focus:ring-2 focus:ring-[#1876CF]"
          />
          <input
            type="text"
            name="clinic"
            aria-label="Название клиники"
            placeholder="Название клиники"
            required
            class="w-full bg-white border-0 rounded-2xl px-4 py-5 text-base focus:outline-none focus:ring-2 focus:ring-[#1876CF]"
          />
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-[#002649] text-white py-4 rounded-2xl font-medium text-lg leading-[1.275] hover:bg-[#16224f] transition"
          >
            Записаться на<br class="sm:hidden" /> презентацию →
          </button>
          <p class="text-center text-xs text-[#81909D]">
            Нажимая кнопку, вы соглашаетесь на обработку персональных данных
          </p>
          </form>
        </div>
      </div>
    </section>

    <!-- БЛОК 8. ПОДВАЛ (footer) -->
    <footer class="bg-white py-6 px-6 text-center text-[#002649] text-base">
      <p>© 2026 TomaDesk. Все права защищены.</p>
    </footer>

    <script>
      const siteHeader = document.getElementById('site-header');
      const updateHeaderBorder = () => {
        const scrolled = window.scrollY > 0;
        siteHeader?.classList.toggle('shadow-[0_8px_30px_0_rgba(125,136,147,0.2)]', scrolled);
      };
      updateHeaderBorder();
      window.addEventListener('scroll', updateHeaderBorder, { passive: true });

      const form = document.getElementById('lead-form') as HTMLFormElement;
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        btn.textContent = '✓ Заявка принята! Скоро свяжемся с вами.';
        btn.style.backgroundColor = '#22c55e';
        btn.disabled = true;
      });

      const langToggle = document.getElementById('lang-toggle');
      const langMenu = document.getElementById('lang-menu');
      langToggle?.addEventListener('click', () => {
        langMenu?.classList.toggle('hidden');
      });
      document.addEventListener('click', (e) => {
        if (!langToggle?.contains(e.target as Node) && !langMenu?.contains(e.target as Node)) {
          langMenu?.classList.add('hidden');
        }
      });

      const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
      const tabPanels = document.querySelectorAll<HTMLDivElement>('[data-tab-panel]');
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-tab-btn');
          tabButtons.forEach((b) => {
            const active = b.getAttribute('data-tab-btn') === key;
            b.classList.toggle('bg-[#002649]', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('bg-white', !active);
            b.classList.toggle('text-[#1876CF]', !active);
            b.classList.toggle('border', !active);
            b.classList.toggle('border-[#E3EFFB]', !active);
            b.classList.toggle('hover:bg-[#E3EFFB]/40', !active);
          });
          tabPanels.forEach((p) => {
            p.classList.toggle('hidden', p.getAttribute('data-tab-panel') !== key);
          });
        });
      });

      const faqItems = document.querySelectorAll<HTMLDivElement>('[data-faq-item]');
      faqItems.forEach((item) => {
        const toggle = item.querySelector('[data-faq-toggle]');
        const answer = item.querySelector('[data-faq-answer]');
        const icon = item.querySelector('[data-faq-icon]');
        const iconSvg = icon?.querySelector('svg');
        toggle?.addEventListener('click', () => {
          const isOpen = !answer?.classList.contains('hidden');
          faqItems.forEach((other) => {
            other.querySelector('[data-faq-answer]')?.classList.add('hidden');
            const otherIcon = other.querySelector('[data-faq-icon]');
            otherIcon?.classList.remove('w-10', 'h-10', 'rounded-lg');
            otherIcon?.classList.add('w-3', 'h-3', 'rounded-full');
            otherIcon?.querySelector('svg')?.classList.add('hidden');
          });
          if (!isOpen) {
            answer?.classList.remove('hidden');
            icon?.classList.remove('w-3', 'h-3', 'rounded-full');
            icon?.classList.add('w-10', 'h-10', 'rounded-lg');
            iconSvg?.classList.remove('hidden');
            iconSvg?.classList.add('rotate-45');
          }
        });
      });
    </script>

  </body>
</html>
